# PostgreSQL/PostGIS connection string (SQLAlchemy URL, psycopg v3 driver).
# The plain "postgresql://" scheme is also accepted and is upgraded to
# "postgresql+psycopg://" automatically.
# These credentials match the docker-compose.yaml service (transit-db).
DATABASE_URL=postgresql+psycopg://transit:cambia_esto@localhost:5432/transit

# Optional overrides (all have sensible defaults / CLI flags):
#GTFS_LOG_LEVEL=INFO
#GTFS_REPORT_DIR=out

# Phase 3 (conflate-osm): where the OSM extract lives in the same database.
# Defaults match an osm2pgsql "classic" import; change if yours differ.
#GTFS_OSM_LINE_TABLE=planet_osm_line
#GTFS_OSM_POINT_TABLE=planet_osm_point
#GTFS_OSM_GEOM_COLUMN=way
# Metric CRS for distance/side math (default: auto-detect a UTM zone).
#GTFS_METRIC_CRS=EPSG:32618